DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WHISPER_PYTHON_PATH=.venv/bin/python
WHISPER_MODEL=base
WHISPER_CACHE_DIR=.whisper-cache
YT_DLP_PATH=yt-dlp
# Optional, administrator-provided cookie file for automatic Douyin downloads.
DOUYIN_COOKIES_FILE=
# Local development opt-in only, for example: chrome
DOUYIN_BROWSER_COOKIES=
# Official OAuth/commercial API or a contracted data provider only.
# The HTTPS endpoint may return JSON or the documented Weibo hotlist HTML table.
# JSON may include { topics: [{ rank, topic, heat, change, url, source, summary }] }.
WEIBO_HOTLIST_API_URL=
WEIBO_HOTLIST_API_TOKEN=
# Local development only: read an already signed-in browser session in memory.
WEIBO_BROWSER_COOKIES=
WEIBO_COOKIE_PYTHON_PATH=.venv/bin/python
